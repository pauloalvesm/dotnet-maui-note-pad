<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotePad.App.Views.NotePage"
             Title="NotePage">
    <VerticalStackLayout Spacing="10" Margin="10">
        <Editor x:Name="TextEditor"
                Placeholder="Write your note"
                HeightRequest="100" 
                Text="{Binding Text}"/>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button 
                x:Name="btnSave"
                Text="Save"
                Clicked="btnSave_Clicked"
                BackgroundColor="#32CD32"
                TextColor="#FFFFFF"
                CornerRadius="10"
                FontAttributes="Bold">
                <Button.ImageSource>
                    <FontImageSource Glyph="✓" Color="#FFFFFF" Size="18" />
                </Button.ImageSource>
            </Button>
            <Button
                Grid.Column="1"
                x:Name="btnDelete"
                Text="Delete"
                Clicked="btnDelete_Clicked"
                BackgroundColor="#FF0000"
                TextColor="#FFFFFF"
                CornerRadius="10"
                FontAttributes="Bold">
                <Button.ImageSource>
                    <FontImageSource Glyph="✕" Color="#FFFFFF" Size="18" />
                </Button.ImageSource>
            </Button>
        </Grid>
    </VerticalStackLayout>
</ContentPage>