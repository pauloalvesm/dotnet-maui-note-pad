<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NotePad.App.Models"
             x:Class="NotePad.App.Views.AboutPage"
             Title="About">
    <ContentPage.BindingContext>
        <models:About />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Margin="20" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Image Source="paulo.png" 
                       WidthRequest="80" 
                       HeightRequest="80" 
                       HorizontalOptions="Center" />

                <Label FontSize="24" 
                       FontAttributes="Bold" 
                       Text="{Binding Title}" 
                       HorizontalOptions="Center" />

                <Label FontSize="16" 
                       TextColor="#FFFFFF" 
                       Text="{Binding Version}" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label Text="{Binding Description}" 
                   FontSize="16" 
                   LineBreakMode="WordWrap" 
                   HorizontalTextAlignment="Center" />

            <Button x:Name="btnAbout" 
                    Text="Learn more about the author..." 
                    Clicked="btnAbout_Clicked"
                    BackgroundColor="#0078D4"
                    TextColor="#FFFFFF"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    Margin="0,10,0,0">
                <Button.ImageSource>
                    <FontImageSource Glyph="ⓘ" Color="#FFFFFF" Size="20" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>